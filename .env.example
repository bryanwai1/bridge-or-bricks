# Supabase project — Settings -> API in the dashboard.
# The anon key is public by design: it ships inside the JS bundle.
# Row-level security in supabase/schema.sql is what limits it.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SHA-256 of your standing facilitator passcode. Generate it with:
#   node -e "console.log(require('crypto').createHash('sha256').update('bob:v1:'+process.argv[1]).digest('hex'))" 'your-passcode'
VITE_ADMIN_HASH=
